{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "go",
      "name": "Diamond: Auditor STABLE",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/../didactic-octo-chrome/cmd/orchestrator/main.go",
      "console": "integratedTerminal"
    },
    {
      "type": "go",
      "name": "Local: go_modules (docker-less)",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/dependabot",
      "envFile": "${workspaceFolder}/.env",
      "env": { "DEPENDABOT_LOCAL": "1" },
      "args": ["update", "go_modules", "."],
      "console": "integratedTerminal"
    }
  ]
}
