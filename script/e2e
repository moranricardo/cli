#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

if ! command -v go >/dev/null 2>&1; then echo "❌ Go missing" >&2; exit 1; fi

echo "Using: $(go version)"
echo "⚠️  No e2e tests found in ./cmd/dependabot (dependabot_test.go removed upstream) - running unit tests"
go test ./... -count=1 -v "${@:+ -run $@}"
